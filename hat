#!/usr/bin/env bash
# hat — the Sorting Hat: suggests appropriate filenames based on file contents
# Uses any OpenAI-compatible API (local or remote) with optional vision support
set -euo pipefail

LLM_BASE_URL="${LLM_BASE_URL:-http://localhost:8080}"
HAT_MODEL="${HAT_MODEL:-gpt-4o}"
REASONING_BUDGET="${HAT_REASONING_BUDGET:-1024}"

usage() {
  cat <<'HELP'
hat — the Sorting Hat for files

Suggests appropriate filenames based on file contents using an LLM.
Works with any OpenAI-compatible API — local (llama.cpp, Ollama, vLLM)
or cloud (OpenAI, Anthropic via proxy, etc).

Usage:
  hat <file> [file...]        Suggest and prompt to rename
  hat -y <file>               Auto-rename without confirmation
  hat --dry-run <file>        Show suggestion without renaming
  hat --batch <dir>           Process all files in a directory
  hat --image <file>          Use vision model for image files
  hat --quiet <file>          No animation, just print the name

Options:
  --yes, -y         Auto-rename without confirmation
  --batch, -b       Process all files in a directory
  --image, -i       Use vision model for image files
  --dry-run, -n     Just show suggestions, no rename
  --quiet, -q       Suppress animation (for scripting)
  --ext, -e         Preserve original extension (default: true)
  --no-ext          Let the model choose the extension too
  --budget, -rb     Reasoning token budget (default: 1024, -1 for unlimited)
  --nothink         Disable thinking entirely (equivalent to --budget 0)
  --context, -c     Additional context to guide naming (e.g. "Q3 marketing")
  --no-metadata     Don't include file metadata in LLM context
  --force, -f       Skip name quality check, always suggest a new name

Environment:
  LLM_BASE_URL             OpenAI-compatible base URL (default: http://localhost:8080)
  HAT_MODEL                Model name to use (default: gpt-4o)
  HAT_API_KEY              API key for the LLM (optional, for cloud providers)
  HAT_REASONING_BUDGET     Reasoning token budget (default: 1024)

Examples:
  hat report.txt
  hat -y IMG_20240301_143022.jpg
  hat --batch ~/Downloads/
  hat --image screenshot.png
  hat -c "quarterly finance report" document.pdf
  hat --batch --force ~/unsorted/

  # With Ollama
  LLM_BASE_URL=http://localhost:11434 HAT_MODEL=llava hat photo.jpg

  # With OpenAI
  LLM_BASE_URL=https://api.openai.com HAT_MODEL=gpt-4o HAT_API_KEY=sk-... hat file.txt

  # With HuggingFace Inference
  LLM_BASE_URL=https://api-inference.huggingface.co/models/Qwen/Qwen2.5-72B-Instruct HAT_API_KEY=hf_... hat file.txt
HELP
  exit 0
}

is_binary() {
  # Use file(1) for reliable binary detection — checks magic bytes and content
  local mime
  mime=$(file --brief --mime-encoding "$1" 2>/dev/null)
  [[ "$mime" == "binary" ]]
}

# Detect image by magic bytes first, then fall back to extension
is_image() {
  local file="$1"
  # Check magic bytes
  local magic
  magic=$(head -c 16 "$file" 2>/dev/null | od -A n -t x1 -N 16 2>/dev/null | tr -d ' \n')
  # JPEG: ff d8 ff
  [[ "$magic" == ffd8ff* ]] && return 0
  # PNG: 89 50 4e 47
  [[ "$magic" == 89504e47* ]] && return 0
  # GIF: 47 49 46 38
  [[ "$magic" == 47494638* ]] && return 0
  # BMP: 42 4d
  [[ "$magic" == 424d* ]] && return 0
  # TIFF: 49 49 2a 00 (little-endian) or 4d 4d 00 2a (big-endian)
  [[ "$magic" == 49492a00* ]] || [[ "$magic" == 4d4d002a* ]] && return 0
  # WebP: 52 49 46 46 ... 57 45 42 50
  [[ "$magic" == 52494646* ]] && [[ "${magic:16:8}" == "57454250" ]] && return 0
  # Fall back to extension for SVG (text-based) and edge cases
  local ext="${file##*.}"
  ext="${ext,,}"
  [[ "$ext" =~ ^(svg)$ ]]
}

# Ask the LLM if a filename already describes the file content well.
# Returns 0 if the name needs renaming (LLM says NO), 1 if it's already good (YES).
# Also outputs the check conversation JSON (messages array) for use as context in turn 2.
check_filename() {
  local file="$1" mode="$2" basename="$3" metadata="${4:-}"

  local check_prompt="Given this file and its current filename \"$basename\", is the filename already a good, descriptive name for the content? Reply ONLY 'YES' or 'NO'."

  if [[ -n "$metadata" && "$metadata" != "{}" ]]; then
    check_prompt="$check_prompt

File metadata: $metadata"
  fi

  local result
  if ! result=$(python3 - "$file" "$mode" "$check_prompt" "$HAT_MODEL" "$REASONING_BUDGET" "${LLM_BASE_URL}" "${HAT_API_KEY:-}" <<'CHECKEOF'
import json, sys, base64, io, urllib.request, re, os

file, mode, prompt, model = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
budget = int(sys.argv[5])
base_url, api_key = sys.argv[6], sys.argv[7] if len(sys.argv) > 7 else ""

# Build user message content
if mode == "image":
    ext = file.rsplit('.', 1)[-1].lower() if '.' in file else ''
    if ext in ('webp', 'bmp', 'tiff', 'tif', 'gif'):
        from PIL import Image
        img = Image.open(file).convert('RGB')
        buf = io.BytesIO()
        img.save(buf, format='PNG')
        b64 = base64.b64encode(buf.getvalue()).decode()
        mime = 'image/png'
    else:
        with open(file, 'rb') as f:
            b64 = base64.b64encode(f.read()).decode()
        mime = {'jpg':'image/jpeg','jpeg':'image/jpeg','png':'image/png',
                'svg':'image/svg+xml'}.get(ext, 'image/jpeg')
    user_content = [
        {'type': 'image_url', 'image_url': {'url': f'data:{mime};base64,{b64}'}},
        {'type': 'text', 'text': prompt}
    ]
else:
    with open(file, 'r', errors='replace') as f:
        content = f.read(4000)
    user_content = prompt + '\n\nFile contents:\n' + content

messages = [{'role': 'user', 'content': user_content}]
payload = {'model': model, 'stream': False, 'temperature': 0.1, 'max_tokens': 10, 'messages': messages}
if budget >= 0:
    payload['thinking_budget_tokens'] = 0  # no reasoning needed for yes/no

headers = {'Content-Type': 'application/json'}
if api_key:
    headers['Authorization'] = f'Bearer {api_key}'

req = urllib.request.Request(f'{base_url}/v1/chat/completions',
    data=json.dumps(payload).encode(), headers=headers)
try:
    with urllib.request.urlopen(req, timeout=60) as resp:
        data = json.loads(resp.read())
except urllib.error.URLError as e:
    print(f'error: could not reach LLM at {base_url}: {e.reason}', file=sys.stderr)
    sys.exit(1)
except Exception as e:
    print(f'error: LLM request failed: {e}', file=sys.stderr)
    sys.exit(1)

answer = data['choices'][0]['message']['content']
answer = re.sub(r'<think>.*?</think>', '', answer, flags=re.DOTALL).strip().upper()

# Output: verdict on line 1, then the messages JSON for multi-turn context on line 2
verdict = 'YES' if 'YES' in answer else 'NO'
# Build conversation history for turn 2
messages.append({'role': 'assistant', 'content': verdict})
print(verdict)
print(json.dumps(messages))
CHECKEOF
  ); then
    return 2  # error
  fi

  local verdict
  verdict=$(echo "$result" | head -1)
  # Export the conversation context for turn 2
  CHECK_MESSAGES=$(echo "$result" | tail -1)

  if [[ "$verdict" == "YES" ]]; then
    return 1  # name is already good
  fi
  return 0  # needs renaming
}

# Collect file metadata as JSON
collect_metadata() {
  local file="$1" mode="$2"
  python3 -c "
import sys, os, datetime, json, mimetypes
file, mode = sys.argv[1], sys.argv[2]
meta = {}
stat = os.stat(file)
meta['size_bytes'] = stat.st_size
meta['modified'] = datetime.datetime.fromtimestamp(stat.st_mtime).strftime('%Y-%m-%d %H:%M')
mime, _ = mimetypes.guess_type(file)
if mime:
    meta['mime_type'] = mime
if mode == 'image':
    try:
        from PIL import Image
        from PIL.ExifTags import TAGS
        exif = Image.open(file).getexif()
        if exif:
            ed = {}
            for tid, val in exif.items():
                tag = TAGS.get(tid, tid)
                if isinstance(val, (str, int, float)):
                    ed[str(tag)] = str(val)[:100]
            if ed: meta['exif'] = ed
    except Exception:
        pass
print(json.dumps(meta, ensure_ascii=False))
" "$file" "$mode"
}

# Build the JSON payload for the API call, output to stdout
# If CHECK_MESSAGES is set, uses it as conversation history (multi-turn from check_filename)
build_payload() {
  local file="$1" mode="$2" preserve_ext="$3" metadata="${4:-}"
  local ext="${file##*.}"
  local prior_messages="${CHECK_MESSAGES:-}"

  local ext_instruction
  if [[ "$preserve_ext" == "true" && -n "$ext" && "$ext" != "$file" ]]; then
    ext_instruction="Do NOT include any file extension in your response. Reply with ONLY the name stem."
  else
    ext_instruction="Choose an appropriate extension."
  fi

  local prompt="Suggest a single appropriate filename. Rules:
- Use lowercase with hyphens (kebab-case), no spaces
- Be descriptive but concise (2-5 words)
- $ext_instruction
- Reply with ONLY the filename, nothing else"

  if [[ -n "$CONTEXT" ]]; then
    prompt="$prompt
- Additional context: $CONTEXT"
  fi

  if [[ -n "$metadata" && "$metadata" != "{}" ]]; then
    prompt="$prompt

File metadata: $metadata"
  fi

  python3 - "$file" "$mode" "$prompt" "$HAT_MODEL" "$REASONING_BUDGET" "$prior_messages" <<'BUILDEOF'
import json, base64, sys, io

file, mode, prompt, model = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
budget = int(sys.argv[5])
prior_json = sys.argv[6] if len(sys.argv) > 6 and sys.argv[6] else ""

# Start with prior conversation if available (multi-turn from check_filename)
if prior_json:
    messages = json.loads(prior_json)
    # Turn 2: just the naming instruction (content already in turn 1)
    messages.append({'role': 'user', 'content': prompt})
elif mode == "image":
    ext = file.rsplit('.', 1)[-1].lower() if '.' in file else ''
    if ext in ('webp', 'bmp', 'tiff', 'tif', 'gif'):
        from PIL import Image
        img = Image.open(file).convert('RGB')
        buf = io.BytesIO()
        img.save(buf, format='PNG')
        b64 = base64.b64encode(buf.getvalue()).decode()
        mime = 'image/png'
    else:
        with open(file, 'rb') as f:
            b64 = base64.b64encode(f.read()).decode()
        mime = {'jpg':'image/jpeg','jpeg':'image/jpeg','png':'image/png',
                'svg':'image/svg+xml'}.get(ext, 'image/jpeg')
    messages = [{'role': 'user', 'content': [
        {'type': 'image_url', 'image_url': {'url': f'data:{mime};base64,{b64}'}},
        {'type': 'text', 'text': prompt}
    ]}]
else:
    with open(file, 'r', errors='replace') as f:
        content = f.read(4000)
    if not content.strip():
        print('{}')
        sys.exit(0)
    messages = [{'role': 'user', 'content': prompt + '\n\nFile contents:\n' + content}]

payload = {'model': model, 'stream': True, 'temperature': 0.3, 'messages': messages}
if budget >= 0:
    payload['thinking_budget_tokens'] = budget
print(json.dumps(payload))
BUILDEOF
}

# Sanitize raw LLM answer into a valid filename stem
# Usage: sanitize_name RAW_ANSWER PRESERVE_EXT ORIGINAL_EXT
sanitize_name() {
  python3 - "$1" "$2" "$3" <<'SANITIZE'
import re, sys
answer, preserve_ext, orig_ext = sys.argv[1], sys.argv[2], sys.argv[3]
answer = re.sub(r"<think>.*?</think>", "", answer, flags=re.DOTALL).strip()
lines = [l.strip().strip('`"\'') for l in answer.split("\n") if l.strip()]
name = lines[-1] if lines else ""
name = name.split("/")[-1]
name = re.sub(r"[^a-zA-Z0-9._-]", "-", name)
name = re.sub(r"-+", "-", name).strip("-")
if preserve_ext == "true" and orig_ext:
    if "." in name:
        name = name.rsplit(".", 1)[0]
    name = name + "." + orig_ext
print(name)
SANITIZE
}

# Stream the LLM response with sorting hat animation on stderr, print filename on stdout
stream_with_hat() {
  local file="$1" mode="$2" preserve_ext="$3" metadata="${4:-}"
  local fname orig_ext=""
  fname=$(basename "$file")
  if [[ "$preserve_ext" == "true" && "$fname" == *.* ]]; then
    orig_ext="${fname##*.}"
  fi

  local payload
  payload=$(build_payload "$file" "$mode" "$preserve_ext" "$metadata")

  local tmpjson
  tmpjson=$(mktemp)
  echo "$payload" > "$tmpjson"

  local raw_answer
  if ! raw_answer=$(python3 - "$LLM_BASE_URL" "$fname" "$tmpjson" "${HAT_API_KEY:-}" <<'PYEOF'
import sys, json, re, urllib.request, textwrap, time, os

url = sys.argv[1]
filename = sys.argv[2]
payload_file = sys.argv[3]
api_key = sys.argv[4] if len(sys.argv) > 4 else ""

with open(payload_file) as f:
    payload = f.read().encode()
os.unlink(payload_file)

BUBBLE_W = 44

HAT_BODY = [
    r"        /\         ",
    r"       /  '.       ",
    r"      / .-'        ",
]

HAT_THINK_FACES = [
    [r"     | o  o |      ", r"     / ~~~~ \      "],
    [r"     | -  o |      ", r"     / ~~~~ \      "],
    [r"     | o  - |      ", r"     / ---- \      "],
    [r"     | o  o |      ", r"     / ---- \      "],
]

HAT_HAPPY_FACE = [r"     | ^  ^ |      ", r"     / \vv/ \      "]
HAT_BRIM = r"  __/````````\__   "

def hat_think(frame_idx):
    face = HAT_THINK_FACES[frame_idx % len(HAT_THINK_FACES)]
    return HAT_BODY + face + [HAT_BRIM]

def hat_happy():
    return HAT_BODY + HAT_HAPPY_FACE + [HAT_BRIM]

HAT_H = len(HAT_BODY) + 2 + 1

HAT_DROP_FRAMES = []
_full = hat_think(0)
for offset in range(4, 0, -1):
    frame = ["                    "] * offset + _full + ["                    "] * (4 - offset)
    HAT_DROP_FRAMES.append(frame)

DIM = "\033[2m"
BOLD = "\033[1m"
RESET = "\033[0m"
YELLOW = "\033[33m"
GREEN = "\033[32m"

tty = os.open("/dev/tty", os.O_WRONLY) if os.path.exists("/dev/tty") else None

def write_tty(s):
    if tty is not None:
        os.write(tty, s.encode())
    else:
        sys.stderr.write(s)
        sys.stderr.flush()

def wrap_text(text, width):
    if not text:
        return [""]
    lines = []
    for paragraph in text.split('\n'):
        if not paragraph.strip():
            lines.append("")
            continue
        wrapped = textwrap.wrap(paragraph, width=width, break_long_words=True, break_on_hyphens=True)
        lines.extend(wrapped if wrapped else [""])
    return lines

def render_bubble(lines, width, tail=False):
    out = []
    out.append("  \u250c" + "\u2500" * (width + 2) + "\u2510")
    for line in lines:
        out.append("  \u2502 " + line.ljust(width) + " \u2502")
    if tail:
        out.append("  \u2514\u2500\u2500\u2500" + "\u2500" * (width - 1) + "\u2518")
        out.append("     \\")
        out.append("      \\")
        out.append("       |")
    else:
        out.append("  \u2514" + "\u2500" * (width + 2) + "\u2518")
    return out

def render_thinking(thinking_text, frame_idx, fname):
    hat_lines = hat_think(frame_idx)
    all_lines = wrap_text(thinking_text, BUBBLE_W)
    visible = all_lines[-3:] if len(all_lines) > 3 else all_lines
    while len(visible) < 2:
        visible.insert(0, "")
    bubble = render_bubble(visible, BUBBLE_W, tail=True)
    out = bubble
    out += [f"  {YELLOW}{line}{RESET}" for line in hat_lines]
    out.append(f"    {DIM}{fname}{RESET}")
    return out

def render_result(name, fname):
    pad = BUBBLE_W - len(name)
    bubble = render_bubble(["PLACEHOLDER"], BUBBLE_W, tail=True)
    bubble[1] = f"  \u2502 {BOLD}{GREEN}{name}{RESET}" + " " * max(0, pad) + " \u2502"
    hat_lines = hat_happy()
    out = bubble
    out += [f"  {YELLOW}{line}{RESET}" for line in hat_lines]
    out.append(f"    {BOLD}{GREEN}{name}{RESET}")
    return out

def clear_and_draw(lines, prev_line_count):
    if prev_line_count > 0:
        write_tty(f"\033[{prev_line_count}A")
        write_tty("\033[J")
    for line in lines:
        write_tty(line + "\n")
    return len(lines)

# === Drop animation ===
write_tty("\033[?25l")

total_h = 17
write_tty("\n" * total_h)
write_tty(f"\033[{total_h}A")
prev_count = 0

for i, drop_frame in enumerate(HAT_DROP_FRAMES):
    frame = []
    for line in drop_frame:
        frame.append(f"  {YELLOW}{line}{RESET}")
    while len(frame) < HAT_H + 4:
        frame.append("")
    frame.append(f"    {DIM}{filename}{RESET}")
    prev_count = clear_and_draw(frame, prev_count)
    time.sleep(0.12)

# === Thinking phase ===
time.sleep(0.2)
frame_lines = render_thinking("Hmm, interesting...", 0, filename)
prev_count = clear_and_draw(frame_lines, prev_count)

headers = {"Content-Type": "application/json"}
if api_key:
    headers["Authorization"] = f"Bearer {api_key}"

req = urllib.request.Request(
    f"{url}/v1/chat/completions",
    data=payload,
    headers=headers
)

thinking_buf = ""
answer_buf = ""
in_think = False
think_done = False
frame_idx = 0
last_render = 0

try:
    with urllib.request.urlopen(req, timeout=300) as resp:
        buf = ""
        while True:
            chunk = resp.read(1)
            if not chunk:
                break
            buf += chunk.decode("utf-8", errors="replace")

            while "\n" in buf:
                line, buf = buf.split("\n", 1)
                line = line.strip()

                if not line.startswith("data: "):
                    continue
                data_str = line[6:]
                if data_str == "[DONE]":
                    break

                try:
                    evt = json.loads(data_str)
                except json.JSONDecodeError:
                    continue

                delta = evt.get("choices", [{}])[0].get("delta", {})
                token = delta.get("content", "")
                reasoning = delta.get("reasoning_content", "")

                if reasoning:
                    thinking_buf += reasoning
                elif token:
                    answer_buf += token
                    combined = answer_buf
                    if "<think>" in combined and "</think>" not in combined:
                        in_think = True
                        thinking_buf += combined.split("<think>", 1)[1]
                        answer_buf = ""
                        continue
                    elif in_think:
                        if "</think>" in combined:
                            before_end = combined.split("</think>", 1)[0]
                            thinking_buf += before_end
                            answer_buf = combined.split("</think>", 1)[1]
                            in_think = False
                            think_done = True
                        else:
                            thinking_buf += token
                            answer_buf = ""
                        continue

                now = time.time()
                if now - last_render > 0.1:
                    display = thinking_buf[-BUBBLE_W * 3:] if thinking_buf else "Hmm..."
                    display = display.replace("\n\n", "\n").strip()
                    frame_idx += 1
                    frame_lines = render_thinking(display, frame_idx, filename)
                    prev_count = clear_and_draw(frame_lines, prev_count)
                    last_render = now

except urllib.error.URLError as e:
    write_tty(f"\033[?25h")
    write_tty(f"\n  error: could not reach LLM at {url}: {e.reason}\n")
    if tty is not None:
        os.close(tty)
    sys.exit(1)
except Exception as e:
    write_tty(f"\033[?25h")
    write_tty(f"\n  error: LLM request failed: {e}\n")
    if tty is not None:
        os.close(tty)
    sys.exit(1)

# Print raw answer for bash to sanitize via shared sanitize_name
raw = answer_buf
write_tty(f"\033[?25h")
if tty is not None:
    os.close(tty)
print(raw)
PYEOF
); then
    return 1
  fi

  local name
  name=$(sanitize_name "$raw_answer" "$preserve_ext" "$orig_ext")

  # Re-render the result with the final name (on tty)
  if [[ -n "$name" ]] && [[ -t 2 ]]; then
    python3 - "$name" "$fname" <<'REVEAL'
import sys, os
name, fname = sys.argv[1], sys.argv[2]
BOLD, GREEN, YELLOW, RESET = '\033[1m', '\033[32m', '\033[33m', '\033[0m'
BUBBLE_W = 44
tty = os.open('/dev/tty', os.O_WRONLY) if os.path.exists('/dev/tty') else None
def w(s):
    if tty: os.write(tty, s.encode())
    else: sys.stderr.write(s); sys.stderr.flush()
hat = [r"        /\         ", r"       /  '.       ", r"      / .-'        ",
       r"     | ^  ^ |      ", r"     / \vv/ \      ", r"  __/````````\__   "]
pad = BUBBLE_W - len(name)
w('\u250c' + '\u2500'*(BUBBLE_W+2) + '\u2510\n')
w('\u2502 ' + f'{BOLD}{GREEN}{name}{RESET}' + ' '*max(0,pad) + ' \u2502\n')
w('\u2514\u2500\u2500\u2500' + '\u2500'*(BUBBLE_W-1) + '\u2518\n')
w('     \\\n      \\\n       |\n')
for l in hat: w(f'  {YELLOW}{l}{RESET}\n')
w(f'    {BOLD}{GREEN}{name}{RESET}\n\n')
if tty: os.close(tty)
REVEAL
  fi

  echo "$name"
}

# Non-animated fallback
suggest_quiet() {
  local file="$1" mode="$2" preserve_ext="$3" metadata="${4:-}"
  local orig_ext=""
  if [[ "$preserve_ext" == "true" && "$file" == *.* ]]; then
    orig_ext="${file##*.}"
  fi

  local payload
  payload=$(build_payload "$file" "$mode" "$preserve_ext" "$metadata")

  local raw_answer
  if ! raw_answer=$(echo "$payload" | python3 -c "
import json, sys, urllib.request, os

payload = sys.stdin.read().encode()
p = json.loads(payload)
p['stream'] = False
payload = json.dumps(p).encode()

headers = {'Content-Type': 'application/json'}
api_key = os.environ.get('HAT_API_KEY', '')
if api_key:
    headers['Authorization'] = f'Bearer {api_key}'

req = urllib.request.Request(
    '${LLM_BASE_URL}/v1/chat/completions',
    data=payload,
    headers=headers)
try:
    with urllib.request.urlopen(req, timeout=300) as resp:
        data = json.loads(resp.read())
except urllib.error.URLError as e:
    print(f'error: could not reach LLM at ${LLM_BASE_URL}: {e.reason}', file=sys.stderr)
    sys.exit(1)
except Exception as e:
    print(f'error: LLM request failed: {e}', file=sys.stderr)
    sys.exit(1)

content = data['choices'][0]['message']['content']
print(content)
"); then
    return 1
  fi

  sanitize_name "$raw_answer" "$preserve_ext" "$orig_ext"
}

process_file() {
  local file="$1"
  local do_rename="$2"
  local preserve_ext="$3"
  local force_image="$4"
  local quiet="$5"

  if [[ ! -f "$file" ]]; then
    echo "Not a file: $file" >&2
    return 1
  fi

  local basename
  basename=$(basename "$file")
  local dir
  dir=$(dirname "$file")

  local mode="text"
  if [[ "$force_image" == "true" ]] || is_image "$file"; then
    mode="image"
  fi

  if [[ "$mode" == "text" ]] && is_binary "$file"; then
    echo "  $basename: binary file, skipping (no analyzable content)" >&2
    return 0
  fi

  # Collect metadata
  local metadata=""
  if [[ "$INCLUDE_METADATA" == "true" ]]; then
    metadata=$(collect_metadata "$file" "$mode" 2>/dev/null) || metadata=""
  fi

  # Guard clause: ask the LLM if the filename is already descriptive
  CHECK_MESSAGES=""
  if [[ "$FORCE" != "true" ]]; then
    local check_rc=0
    check_filename "$file" "$mode" "$basename" "$metadata" || check_rc=$?
    if [[ $check_rc -eq 1 ]]; then
      echo "  $basename: name looks good, skipping (use --force to override)" >&2
      return 0
    elif [[ $check_rc -eq 2 ]]; then
      echo "  $basename: LLM check failed" >&2
      return 1
    fi
    # check_rc == 0: needs renaming, CHECK_MESSAGES is set for multi-turn context
  fi

  local suggested
  if [[ "$quiet" == "true" ]] || ! [[ -t 2 ]]; then
    if ! suggested=$(suggest_quiet "$file" "$mode" "$preserve_ext" "$metadata"); then
      echo "  $basename: LLM request failed" >&2
      return 1
    fi
    echo "  $basename → $suggested" >&2
  else
    if ! suggested=$(stream_with_hat "$file" "$mode" "$preserve_ext" "$metadata"); then
      return 1
    fi
  fi

  if [[ -z "$suggested" ]]; then
    echo "  $basename → (no suggestion)" >&2
    return 1
  fi

  # Guard: if the model thinks the current name is already appropriate
  if [[ "$suggested" == "$basename" ]]; then
    echo "  Hat thinks the name is already appropriate: $basename" >&2
    echo "$suggested"
    return 0
  fi

  # Deduplicate: if target exists (and isn't the file itself), append -1, -2, etc.
  local target="$dir/$suggested"
  if [[ -e "$target" && "$target" != "$file" ]]; then
    local base ext_part counter
    if [[ "$suggested" == *.* ]]; then
      base="${suggested%.*}"
      ext_part=".${suggested##*.}"
    else
      base="$suggested"
      ext_part=""
    fi
    counter=1
    suggested="${base}-${counter}${ext_part}"
    while [[ -e "$dir/$suggested" && "$dir/$suggested" != "$file" ]]; do
      ((counter++))
      suggested="${base}-${counter}${ext_part}"
    done
    target="$dir/$suggested"
    echo "  Target existed, using: $suggested" >&2
  fi

  # After dedup, the final name might match the source file
  if [[ "$suggested" == "$basename" ]]; then
    echo "  Hat thinks the name is already appropriate: $basename" >&2
    echo "$suggested"
    return 0
  fi

  # Output for scripting (stdout) — after dedup so scripts get the real name
  echo "$suggested"

  if [[ "$do_rename" != "false" ]]; then
    if [[ "$do_rename" == "auto" ]]; then
      mv "$file" "$target"
      echo "  Renamed → $target" >&2
    else
      read -r -p "  Rename $suggested? [y/N] " confirm </dev/tty
      if [[ "$confirm" =~ ^[Yy] ]]; then
        mv "$file" "$target"
        echo "  Renamed → $target" >&2
      fi
    fi
  fi
}

# Parse args
DO_RENAME=true
DRY_RUN=false
BATCH=false
FORCE_IMAGE=false
PRESERVE_EXT=true
QUIET=false
CONTEXT=""
INCLUDE_METADATA=true
FORCE=false
FILES=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --help|-h) usage ;;
    --yes|-y) DO_RENAME=auto; shift ;;
    --dry-run|-n) DRY_RUN=true; shift ;;
    --batch|-b) BATCH=true; shift ;;
    --image|-i) FORCE_IMAGE=true; shift ;;
    --ext|-e) PRESERVE_EXT=true; shift ;;
    --no-ext) PRESERVE_EXT=false; shift ;;
    --quiet|-q) QUIET=true; shift ;;
    --budget|-rb) REASONING_BUDGET="$2"; shift 2 ;;
    --nothink) REASONING_BUDGET=0; shift ;;
    --context|-c) CONTEXT="$2"; shift 2 ;;
    --no-metadata) INCLUDE_METADATA=false; shift ;;
    --force|-f) FORCE=true; shift ;;
    -*) echo "Unknown option: $1" >&2; exit 1 ;;
    *) FILES+=("$1"); shift ;;
  esac
done

if [[ ${#FILES[@]} -eq 0 ]]; then
  usage
fi

if [[ "$DRY_RUN" == "true" ]]; then
  DO_RENAME=false
fi

for target in "${FILES[@]}"; do
  if [[ "$BATCH" == "true" && -d "$target" ]]; then
    echo "Sorting files in $target:" >&2
    for f in "$target"/*; do
      [[ -f "$f" ]] || continue
      process_file "$f" "$DO_RENAME" "$PRESERVE_EXT" "$FORCE_IMAGE" "$QUIET" || true
    done
  else
    process_file "$target" "$DO_RENAME" "$PRESERVE_EXT" "$FORCE_IMAGE" "$QUIET"
  fi
done
