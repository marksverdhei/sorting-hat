with open(sys.argv[1]) as f: p = json.load(f)
os.unlink(sys.argv[1])
base_url = sys.argv[2]
api_key = sys.argv[3] if len(sys.argv) > 3 else ""

p['stream'] = False
payload = json.dumps(p).encode()

headers = {'Content-Type': 'application/json'}
if api_key:
    headers['Authorization'] = f'Bearer {api_key}'

req = urllib.request.Request(
    f'{base_url}/v1/chat/completions',
    data=payload,
    headers=headers)
try:
    with urllib.request.urlopen(req, timeout=300) as resp:
        data = json.loads(resp.read())
except urllib.error.URLError as e:
    print(f'error: could not reach LLM at {base_url}: {e.reason}', file=sys.stderr)
    sys.exit(1)
except Exception as e:
    print(f'error: LLM request failed: {e}', file=sys.stderr)
    sys.exit(1)

content = data['choices'][0]['message']['content']
print(content)
QUIETEOF
); then
    return 1
  fi

  sanitize_name "$raw_answer" "$preserve_ext" "$orig_ext"
}

process_file() {
  local file="$1"
  local do_rename="$2"
  local preserve_ext="$3"
  local force_image="$4"
  local quiet="$5"

  if [[ ! -f "$file" ]]; then
    echo "Not a file: $file" >&2
    return 1
  fi

  local basename
  basename=$(basename "$file")
  local dir
  dir=$(dirname "$file")

  local mode="text"
  if [[ "$force_image" == "true" ]] || is_image "$file"; then
    mode="image"
  elif is_audio "$file"; then
    mode="audio"
  elif is_video "$file"; then
    mode="video"
  fi

  if [[ "$mode" == "text" ]] && is_binary "$file"; then
    echo "  $basename: binary file, skipping (no analyzable content)" >&2
    return 0
  fi

  # Collect metadata
  local metadata=""
  if [[ "$INCLUDE_METADATA" == "true" ]]; then
    metadata=$(collect_metadata "$file" "$mode" 2>/dev/null) || metadata=""
  fi

  local suggested
  local do_check="false"
  [[ "$FORCE" != "true" ]] && do_check="true"

  if [[ "$quiet" == "true" ]] || ! [[ -t 2 ]]; then
    # Quiet mode: use non-streaming check + naming
    CHECK_MESSAGES=""
    if [[ "$do_check" == "true" ]]; then
      local check_rc=0
      check_filename "$file" "$mode" "$basename" "$metadata" || check_rc=$?
      if [[ $check_rc -eq 1 ]]; then
        echo "  $basename: hat says name is already good, skipping (use --force to override)" >&2
        return 0
      elif [[ $check_rc -eq 2 ]]; then
        echo "  $basename: LLM check failed" >&2
        return 1
      fi
      echo "  $basename: hat says this name could be better, suggesting..." >&2
    fi
    if ! suggested=$(suggest_quiet "$file" "$mode" "$preserve_ext" "$metadata"); then
      echo "  $basename: LLM request failed" >&2
      return 1
    fi
    echo "  $basename → $suggested" >&2
  else
    # Animated mode: stream_with_hat handles both check and naming in one animation
    if ! suggested=$(stream_with_hat "$file" "$mode" "$preserve_ext" "$metadata" "$do_check"); then
      return 1
    fi
    if [[ "$suggested" == "SKIP" ]]; then
      return 0
    fi
  fi

  if [[ -z "$suggested" ]]; then
    echo "  $basename → (no suggestion)" >&2
    return 1
  fi

  # Guard: if the model thinks the current name is already appropriate
  if [[ "$suggested" == "$basename" ]]; then
    echo "  Hat thinks the name is already appropriate: $basename" >&2
    echo "$suggested"
    return 0
  fi

  # Deduplicate: if target exists (and isn't the file itself), append -1, -2, etc.
  local target="$dir/$suggested"
  if [[ -e "$target" && "$target" != "$file" ]]; then
    local base ext_part counter
    if [[ "$suggested" == *.* ]]; then
      base="${suggested%.*}"
      ext_part=".${suggested##*.}"
    else
      base="$suggested"
      ext_part=""
    fi
    counter=1
    suggested="${base}-${counter}${ext_part}"
    while [[ -e "$dir/$suggested" && "$dir/$suggested" != "$file" ]]; do
      ((counter++))
      suggested="${base}-${counter}${ext_part}"
    done
    target="$dir/$suggested"
    echo "  Target existed, using: $suggested" >&2
  fi

  # After dedup, the final name might match the source file
  if [[ "$suggested" == "$basename" ]]; then
    echo "  Hat thinks the name is already appropriate: $basename" >&2
    echo "$suggested"
    return 0
  fi

  if [[ "$do_rename" == "false" ]]; then
    # Dry-run / scripting: output to stdout immediately
    echo "$suggested"
  elif [[ "$do_rename" == "auto" ]]; then
    mv "$file" "$target"
    echo "  Renamed → $target" >&2
    echo "$suggested"
  else
    read -r -p "  Rename $basename to $suggested? [y/N] " confirm </dev/tty
    if [[ "$confirm" =~ ^[Yy] ]]; then
      mv "$file" "$target"
      echo "  Renamed → $target" >&2
      echo "$suggested"
    fi
  fi
}

# Parse args
DO_RENAME=true
DRY_RUN=false
BATCH=false
FORCE_IMAGE=false
PRESERVE_EXT=true
QUIET=false
CONTEXT=""
INCLUDE_METADATA=true
FORCE=false
FILES=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --help|-h) usage ;;
    --yes|-y) DO_RENAME=auto; shift ;;
    --dry-run|-n) DRY_RUN=true; shift ;;
    --batch|-b) BATCH=true; shift ;;
    --image|-i) FORCE_IMAGE=true; shift ;;
    --ext|-e) PRESERVE_EXT=true; shift ;;
    --no-ext) PRESERVE_EXT=false; shift ;;
    --quiet|-q) QUIET=true; shift ;;
    --budget|-rb) REASONING_BUDGET="$2"; shift 2 ;;
    --nothink) REASONING_BUDGET=0; GUARD_BUDGET=0; shift ;;
    --fullthink) GUARD_BUDGET="match"; shift ;;
    --context|-c) CONTEXT="$2"; shift 2 ;;
    --no-metadata) INCLUDE_METADATA=false; shift ;;
    --force|-f) FORCE=true; shift ;;
    -*) echo "Unknown option: $1" >&2; exit 1 ;;
    *) FILES+=("$1"); shift ;;
  esac
done

if [[ ${#FILES[@]} -eq 0 ]]; then
  usage
fi

if [[ "$DRY_RUN" == "true" ]]; then
  DO_RENAME=false
fi

# Resolve --fullthink: guard budget matches naming budget
if [[ "$GUARD_BUDGET" == "match" ]]; then
  GUARD_BUDGET="$REASONING_BUDGET"
fi

for target in "${FILES[@]}"; do
  if [[ "$BATCH" == "true" && -d "$target" ]]; then
    echo "Sorting files in $target:" >&2
    for f in "$target"/*; do
      [[ -f "$f" ]] || continue
      process_file "$f" "$DO_RENAME" "$PRESERVE_EXT" "$FORCE_IMAGE" "$QUIET" || true
    done
  else
    process_file "$target" "$DO_RENAME" "$PRESERVE_EXT" "$FORCE_IMAGE" "$QUIET"
  fi
done
